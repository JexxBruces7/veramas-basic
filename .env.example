# Salin file ini menjadi ".env" lalu isi.
# JANGAN bagikan file .env ke siapa pun. API key cukup izin "view" dan "trade", JANGAN beri izin "withdraw".

# INDODAX
INDODAX_API_KEY=
INDODAX_SECRET_KEY=

# Kunci bisa juga diisi lewat tombol 🔌 Hubungkan API di aplikasi.
# Kunci Trade API V2 maupun V1 (lama) didukung; versinya terdeteksi otomatis.

# false = SIMULASI (harga asli Indodax, saldo pura-pura). true = LIVE (dana sungguhan).
LIVE_TRADING=false

# Pengaman
# Ukuran Trade bot dan order manual tidak dibatasi (MAX_ORDER_IDR tidak dipakai lagi).
# Batas rugi harian tetap berlaku: bot berhenti bila rugi hari ini mencapai angka ini.
DAILY_LOSS_LIMIT_IDR=200000

# Saldo awal mode simulasi
PAPER_BALANCE_IDR=10000000

PORT=3000

# USDT.D (dominasi USDT) diambil dari API publik CoinGecko tanpa key. Opsional: isi API key "Demo" gratis
# dari coingecko.com agar batas aksesnya lebih longgar. COINGECKO_PRO=true bila key Anda key Pro.
COINGECKO_API_KEY=

# Research Intelligence: sumber berita (RSS), dipisah koma. Kosongkan untuk bawaan
# (CoinDesk, Cointelegraph, Decrypt).
RSS_FEEDS=

# API tambahan (opsional; bisa juga diisi lewat tombol Hubungkan API)
# Tokocrypto & Binance: portofolio. Order spot manual dari dialog API hanya bila *_TRADE=true
# DAN kuncinya berizin trading. Kunci berizin withdraw selalu ditolak.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TRADE=false
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_SECRET_KEY=
TOKOCRYPTO_TRADE=false
# Arkham Intelligence: transfer whale di laporan Market Intelligence
ARKHAM_API_KEY=
# batas minimal transfer whale (USD)
ARKHAM_MIN_USD=10000000

# Data & Intelligence (opsional)
# CoinGlass: likuidasi 24 jam di bagian Derivatif Market Intelligence
COINGLASS_API_KEY=
# Glassnode: alamat aktif & arus bersih BTC ke exchange di Whale & On-Chain
GLASSNODE_API_KEY=
# Messari: jadwal unlock token di Research Intelligence (Tokenomics) dan Penjelajah API
MESSARI_API_KEY=
# CoinMarketCap: peringkat & Fear and Greed (Penjelajah API)
CMC_API_KEY=

# DEX: RPC Solana untuk saldo Phantom (bawaan RPC publik mainnet)
SOLANA_RPC=

# Menu Forex: jembatan MetaTrader 5 (jalankan mt5_bridge.bat). Bawaan http://127.0.0.1:5005
MT5_BRIDGE=
# Menu Macro Economy: RSS berita ekonomi, dipisah koma. Kosongkan untuk bawaan
# (CNN Indonesia Ekonomi, CNN Business, Bloomberg Technoz).
MACRO_RSS=

# Menu Macro Global: RSS berita dunia, dipisah koma. Kosongkan untuk bawaan
# (BBC, Al Jazeera, The Guardian, NPR, DW, TechCrunch AI, GDACS).
GLOBAL_RSS=
# Sumber gempa (biasanya tidak perlu diubah)
USGS_URL=
BMKG_URL=

# Chart saham/forex/komoditas/properti di dashboard: jeda pembaruan harga Yahoo Finance (milidetik, bawaan 30000)
YAHOO_POLL_MS=

# Sumber alternatif USDT.D (tanpa CoinGecko) dan riwayat ALL; biasanya tidak perlu diubah
LLAMA_STABLE_BASE=
COINMETRICS_BASE=
YAHOO_FC=
YAHOO_Q2=

# Encrypt Intelligence (Wallet Treasury): penjelajah on-chain tanpa kunci; biasanya tidak perlu diubah.
# Kosongkan BLOCKSCOUT_TPL untuk bawaan (eth/base/arbitrum/optimism/polygon.blockscout.com).
# Bila diisi, {chain} diganti nama jaringan: ethereum, base, arbitrum, optimism, polygon.
BLOCKSCOUT_TPL=
MEMPOOL_BASE=

# Lisensi (opsional untuk pengembang; wajib untuk pembeli yang memakai mode LIVE)
# Alamat server lisensi Anda (HTTPS). Kosongkan = lisensi tidak bisa dicek, mode LIVE tidak bisa dipakai.
LICENSE_SERVER=
# Tautan halaman beli/perpanjang yang ditampilkan di menu Lisensi.
LICENSE_BUY_URL=
# Berapa hari lisensi tetap berlaku bila server tidak bisa dihubungi (bawaan 30).
LICENSE_GRACE_DAYS=30

# ---- Login (wajib di semua paket) ----
# Kosongkan: saat pertama dibuka Anda diminta membuat akun sendiri.
# Isi kedua baris ini bila ingin akun tetap (tidak bisa diganti dari dashboard):
LOGIN_USER=
LOGIN_PASSWORD=
